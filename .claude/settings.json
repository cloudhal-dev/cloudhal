{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/apps/studio/scripts/design-lint.ts\" --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
