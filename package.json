{
  "name": "cloudhal-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Cloudhal — the open-source, agent-native site platform (monorepo root)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "check": "biome check --diagnostic-level=error . && node scripts/size-check.ts && turbo run typecheck && turbo run test --concurrency=3",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size:check": "node scripts/size-check.ts",
    "size:report": "node scripts/code-size.ts",
    "design:lint": "node apps/studio/scripts/design-lint.ts",
    "design:shots": "node apps/studio/scripts/screenshots.ts",
    "kumo": "pnpm --filter @cloudhal/ui exec kumo",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen": "turbo run gen:ts gen:rs",
    "drift": "pnpm gen && git diff --exit-code -- packages/core-contracts/src/generated crates/cloudhal-schema/src/generated",
    "cargo:test": "cargo test --workspace --locked",
    "cargo:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "changeset": "changeset",
    "release": "pnpm build:packages && changeset publish",
    "gen:ts": "turbo run gen:ts",
    "build:packages": "node scripts/build-packages.ts",
    "smoke:pack": "node scripts/smoke-pack.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
