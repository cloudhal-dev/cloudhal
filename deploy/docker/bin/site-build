#!/bin/sh
# Builds the public site as static HTML and publishes it under /data/site, where a web server (the
# compose file's Caddy) serves /data/site/current:
#   docker compose exec cloudhal site-build
# `cloudhal build` renders into /data/dist, the CLI's fixed output directory, which every build
# empties first — so the served tree is never the one being written. After a successful build the
# output moves to /data/site/<build id> and the `current` symlink is replaced with a single rename,
# which is atomic: visitors see the previous build until the new one is complete, never a 404 or a
# half-written page, and a failed build changes nothing. The build before it is kept (pages opened
# from it still load their assets); older ones are removed.
# The snapshot is the published one, else the latest: before the first publish the site is built
# from the latest snapshot (RFC-0043's `cloudhal build --published` is not in this version). The
# project's dependencies are the image's node_modules, linked into the project on first use, so no
# install and no network is needed.
set -eu
cd /data
if [ ! -f cloudhal.json ]; then
  echo "site-build: no project in /data yet; start the container once first" >&2
  exit 1
fi
# One build at a time: a cron run and a hand-started one would otherwise share /data/dist.
exec 9>/tmp/site-build.lock
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
  echo "site-build: another build is running; try again when it is done" >&2
  exit 1
fi
[ -e node_modules ] || ln -s /opt/cloudhal/node_modules node_modules

# The public origin for canonical links, the sitemap and feeds is the site's primary domain, kept
# in cloudhal.json as `domains.site` (`cloudhal domain set <hostname>`). CLOUDHAL_SITE_URL — the
# origin Caddy serves — sets it when they differ; without either, the build's URLs say localhost.
# Setting the domain never stops the build: a value it cannot use is reported and skipped.
if [ -n "${CLOUDHAL_SITE_URL:-}" ]; then
  host=$(node -e '
    let u;
    try { u = new URL(process.argv[1]); } catch { u = undefined; }
    if (!u || u.protocol !== "https:" || u.port || u.pathname !== "/" || u.search || u.hash) {
      console.error("site-build: CLOUDHAL_SITE_URL must be an https origin without a path or port, such as https://www.example.org (got " + JSON.stringify(process.argv[1]) + "); building without it");
      process.exit(0);
    }
    // the rule for site domains (core-ts isHostname): labels, a dot, a letter TLD
    if (!/^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/.test(u.hostname)) {
      console.error("site-build: " + u.hostname + " cannot be a site domain (no dot, or an IP address); building without it");
      process.exit(0);
    }
    process.stdout.write(u.hostname);
  ' "$CLOUDHAL_SITE_URL")
  case "$host" in
    "") ;;
    example.com | *.example.com | example.net | *.example.net | example.org | *.example.org)
      echo "site-build: CLOUDHAL_SITE_URL is the placeholder $CLOUDHAL_SITE_URL; set the site's real origin, or leave it empty" >&2
      ;;
    *)
      current=$(node -e '
        const cfg = JSON.parse(require("node:fs").readFileSync("cloudhal.json", "utf8"));
        process.stdout.write(cfg.domains?.site ?? "");
      ')
      if [ "$host" != "$current" ]; then
        if cloudhal domain set "$host" >/dev/null; then
          echo "site-build: public origin https://$host (cloudhal.json domains.site; the live site's primary domain)"
          echo "site-build: a published snapshot that names another primary domain keeps it until the next publish"
        else
          echo "site-build: could not make $host the site's domain; building without it" >&2
        fi
      fi
      ;;
  esac
fi

cloudhal build "$@"

# Publish: /data/dist → /data/site/<build id>, then point `current` at it with one rename.
prev=$(readlink site/current 2>/dev/null || true)
id="$(date -u +%Y%m%dT%H%M%SZ).$$"
mkdir -p site
mv dist "site/$id"
rm -f "site/current.$$"
ln -s "$id" "site/current.$$"
mv -T "site/current.$$" site/current
# The build before this one stays, so a page opened from it can still load its hashed assets;
# older builds go.
find site -mindepth 1 -maxdepth 1 -type d ! -name "$id" ! -name "${prev:-$id}" -exec rm -rf {} +
echo "site-build: /data/site/current -> $id"
