#!/bin/sh
# The image's entrypoint (RFC-0047 §5). `start` (the default), `secrets`, `config` and `check` are
# `cloudhal-selfhost <command>`; anything else runs as given.
set -eu
case "${1:-start}" in
  start | secrets | config | check)
    cmd="${1:-start}"
    [ $# -gt 0 ] && shift
    exec /opt/cloudhal/bin/cloudhal-selfhost "$cmd" "$@"
    ;;
esac
exec "$@"
