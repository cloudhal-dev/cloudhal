#!/bin/sh
# The image's entrypoint: `studio` (the default command) runs `cloudhal studio` in /data and
# scaffolds the project first when the volume is empty; anything else runs as given, so
# `docker run … cloudhal export` or `docker compose exec cloudhal site-build` work too.
set -eu
cd /data
# An empty BETTER_AUTH_SECRET (a blank value in .env) would be taken as the secret itself: treat it
# as unset, so the secret created on the volume stays in use.
if [ -z "${BETTER_AUTH_SECRET-unset}" ]; then unset BETTER_AUTH_SECRET; fi
if [ "${1:-studio}" = "studio" ]; then
  # Behind a proxy the public origin is required (`cloudhal studio` refuses to start without one).
  # A localhost origin there is a leftover default, such as a .env from 0.6.3, and would only fail
  # every sign-in with 403: refuse it as loudly.
  proxy=$(printf '%s' "${CLOUDHAL_BEHIND_PROXY:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
  case "$proxy" in
    1 | true | yes | on)
      case "${CLOUDHAL_BASE_URL:-}" in
        http://localhost | http://localhost:* | https://localhost | https://localhost:* | \
          http://127.0.0.1 | http://127.0.0.1:* | https://127.0.0.1 | https://127.0.0.1:*)
          echo "entrypoint: CLOUDHAL_BEHIND_PROXY=1 needs CLOUDHAL_BASE_URL set to the public origin browsers open Studio at, not $CLOUDHAL_BASE_URL" >&2
          exit 1
          ;;
      esac
      ;;
  esac
  # One site build per start: a volume upgraded from an image that built drafts before the first
  # publish then switches at once to the published build or the 503 status page, and a new volume
  # gets the status page, without waiting for a publish. CLOUDHAL_SITE_BUILD=off (the site is built
  # elsewhere) turns it off, with the rebuild on publish. Unset or empty is `on` (the image's
  # default); the normalised value is exported, so `cloudhal studio` (which reads empty as off)
  # agrees with this script.
  site_build=$(printf '%s' "${CLOUDHAL_SITE_BUILD:-on}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
  case "$site_build" in
    "" | on | 1 | true | yes) site_build=on ;;
    *) site_build=off ;;
  esac
  export CLOUDHAL_SITE_BUILD="$site_build"
  # A CLI with the rebuild on publish (#150; its help names CLOUDHAL_SITE_BUILD) runs the start-up
  # build itself, in the same queue and audit log as a publish's. An older one (an image built from
  # these scripts with an older CLOUDHAL_VERSION) gets it from here: in the background once Studio
  # answers (it migrates the database, and on an empty volume creates the project, first); the
  # outer subshell exits at once, so tini (PID 1) reaps the build rather than `cloudhal studio`.
  # `--wait` queues it behind a build that is already running (one lock, /tmp/site-build.lock). A
  # failure changes nothing (site-build publishes only a finished build) and is only logged.
  if [ "$site_build" = on ] && ! cloudhal --help 2>/dev/null | grep -q CLOUDHAL_SITE_BUILD; then
    (
      (
        i=0
        until node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))" 2>/dev/null; do
          i=$((i + 1))
          if [ "$i" -ge 90 ]; then
            echo "entrypoint: Studio did not answer within 180 s; no start-up site-build" >&2
            exit 0
          fi
          sleep 2
        done
        [ -f /data/cloudhal.json ] || exit 0
        echo "entrypoint: start-up site-build"
        CLOUDHAL_SITE_BUILD_SOURCE=start site-build --wait || echo "entrypoint: the start-up site-build failed; the served site is unchanged" >&2
      ) &
    )
  fi
  [ $# -gt 0 ] && shift
  exec cloudhal studio --init-if-empty "$@"
fi
exec "$@"
