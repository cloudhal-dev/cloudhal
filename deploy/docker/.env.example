# Copy to .env next to compose.yml. No secrets live here: Better Auth's secret is created on the
# volume at first start (/data/.cloudhal/auth-secret), and invites are printed to the logs.

# The image tag. `latest` follows every release; pin the minor (`0.6`) in production.
CLOUDHAL_TAG=latest

# Where Studio is reached. Without a reverse proxy: this machine. Behind one (the caddy profile):
# the public https origin, and CLOUDHAL_BEHIND_PROXY=1 so the proxy's X-Forwarded-* headers count.
CLOUDHAL_BASE_URL=http://localhost:8787
CLOUDHAL_BEHIND_PROXY=0
# Which address and port of this machine publish the container's port 8787 (0.0.0.0 to expose it
# directly; keep 127.0.0.1 with the caddy profile).
CLOUDHAL_BIND=127.0.0.1
CLOUDHAL_PORT=8787

# The public site, served by Caddy from `site-build`'s output (caddy profile only).
CLOUDHAL_SITE_URL=https://www.example.com

# The first start on an empty volume creates a project from this starter with this site name.
CLOUDHAL_INIT=blog
CLOUDHAL_SITE_NAME=My site

# Scheduled automations (`off` stops them; releases and gates go on).
CLOUDHAL_AUTOMATIONS=on
# Extra origins the API accepts browser requests from, comma-separated (normally empty).
CLOUDHAL_TRUSTED_ORIGINS=
# Workers AI over REST for Build chat (RFC-0016): both or neither.
CLOUDHAL_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
