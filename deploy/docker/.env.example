# Settings for compose.yml (docs/guides/self-host.md). The secrets are not here: make them once with
#   docker run --rm ghcr.io/cloudhal-dev/cloudhal:latest secrets > .env && chmod 600 .env
# and append the lines below you want to change. Every instance of an installation needs the same
# values; never change CLOUDHAL_SITE_ID or CLOUDHAL_CLUSTER_KEY once the installation exists.
# Treat .env as private: `chmod 600`, never commit it.

# The image tag. `latest` follows every release; pin the minor (`0.11`) in production.
#CLOUDHAL_TAG=latest

# Where browsers open Studio: scheme, host and port, no path (https://studio.example.org behind a
# proxy). Printed in the setup link; required with CLOUDHAL_BEHIND_PROXY=1, where the proxy must
# also overwrite CF-Connecting-IP with the client's address (the caddy profile does).
#CLOUDHAL_BASE_URL=
#CLOUDHAL_BEHIND_PROXY=0

# Which address of this machine publishes Studio (8787) and the site (8788); 0.0.0.0 exposes them
# directly. Keep 127.0.0.1 with the caddy profile.
#CLOUDHAL_BIND=127.0.0.1
#CLOUDHAL_PORT=8787
#CLOUDHAL_SITE_PORT=8788

# The public site's origin, for the caddy profile (https://www.example.org).
#CLOUDHAL_SITE_URL=

# The first start creates the installation's site under CLOUDHAL_SITE_ID with this name.
#CLOUDHAL_SITE_NAME=My site

# The S3 store. Empty: the compose file's SeaweedFS. Another store (AWS S3, GCS's XML API, R2,
# RustFS) must enforce conditional writes (If-None-Match: *, If-Match); MinIO's archived community
# edition and Garage are not supported. Its credentials replace AWS_* from `secrets`.
#CLOUDHAL_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#CLOUDHAL_S3_BUCKET=cloudhal
#CLOUDHAL_S3_PREFIX=
#CLOUDHAL_S3_REGION=us-east-1

# Traces of every Worker invocation to an OTLP/HTTP collector.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
