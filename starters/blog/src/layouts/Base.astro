---
import { SeoHead } from "@cloudhal/astro-renderer/components";
import type { ActiveNavItem } from "@cloudhal/astro-renderer/navigation";
import type { HeadMeta } from "@cloudhal/astro-renderer/seo";
import { themeVariables } from "@cloudhal/astro-renderer/theme-settings";
import type { Site } from "@cloudhal/core-contracts";
import NavLink from "../components/NavLink.astro";
import NavMenu from "../components/NavMenu.astro";
import { themeSettings } from "../settings.ts";
import "../styles/global.css";

interface Props {
  site: Site;
  meta: HeadMeta;
  /** The `primary` menu, or the derived header when the site has none (RFC-0003 §7.3). */
  nav: ActiveNavItem[];
  /** The `footer` menu; undefined keeps the default footer links. */
  footer?: ActiveNavItem[] | undefined;
  /** A preview of an embargoed or expired page or entry says so above it (RFC-0008 §7.3). */
  notice?: { state: string; at: string; text: string } | undefined;
  /** RFC-0019 §3: the header's search form, where the deployment answers searches. */
  search?: { label: string; placeholder: string; button: string; query?: string } | undefined;
}
const { site, meta, nav, footer, notice, search } = Astro.props;
// The site's design settings (RFC-0017 §1): typed values only, defaults where unset.
const look = themeVariables(site, themeSettings);
const header = { on: "text-zinc-900", off: "hover:text-zinc-900" };
const below = { on: "text-zinc-700", off: "hover:text-zinc-700" };
---
<!doctype html>
<html lang={meta.lang} {...look.attributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead meta={meta} />
    {/* public/: static assets, answered before the Site Worker runs (no render, no analytics event) */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content="Cloudhal" />
    {look.style && <style set:html={look.style} />}
  </head>
  <body class="ch-body min-h-screen antialiased">
    <header class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-6">
      <a href="/" class="text-lg font-semibold">{site.name}</a>
      {nav.length > 0 && (
        <nav class="flex flex-wrap gap-4 text-sm text-zinc-600" aria-label="Main">
          {nav.map((item) =>
            item.children.length > 0 ? (
              <NavMenu item={item} {...header} />
            ) : (
              <NavLink item={item} {...header} />
            ),
          )}
        </nav>
      )}
      {search && (
        <form class="ch-header-search" method="get" action="/search" role="search">
          <label for="ch-header-q" class="sr-only">{search.label}</label>
          <input id="ch-header-q" type="search" name="q" value={search.query ?? ""} maxlength="200" placeholder={search.placeholder} />
          <button type="submit" class="sr-only">{search.button}</button>
        </form>
      )}
    </header>
    <main class="mx-auto max-w-3xl px-4 pb-16">
      {notice && (
        <p
          class="ch-gate-notice mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900"
          role="status"
          data-gate={notice.state}
          data-gate-at={notice.at}
        >{notice.text}</p>
      )}
      <slot />
    </main>
    <footer class="mx-auto flex max-w-3xl justify-between gap-4 px-4 py-8 text-xs text-zinc-500">
      <span>Built with Cloudhal</span>
      {footer ? (
        footer.length > 0 && (
          <nav class="flex flex-wrap gap-4" aria-label="Footer">
            {footer.map((item) =>
              item.children.length > 0 ? (
                <NavMenu item={item} {...below} />
              ) : (
                <NavLink item={item} {...below} />
              ),
            )}
          </nav>
        )
      ) : (
        <a href="/rss.xml" class="hover:text-zinc-700">RSS</a>
      )}
    </footer>
  </body>
</html>
