---
import type { Site } from "@cloudhal/core-contracts";
import "../styles/global.css";

interface Props {
  site: Site;
  title: string;
  description?: string;
}
const { site, title, description } = Astro.props;
---
<!doctype html>
<html lang={site.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content="Cloudhal" />
  </head>
  <body class="min-h-screen bg-white text-zinc-900 antialiased">
    <header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6">
      <a href="/" class="text-lg font-semibold">{site.name}</a>
      <nav class="flex gap-4 text-sm text-zinc-600">
        <a href="/about">About</a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 pb-16">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-8 text-xs text-zinc-500">Built with Cloudhal</footer>
  </body>
</html>
