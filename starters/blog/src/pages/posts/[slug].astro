---
import config from "virtual:cloudhal/config";
import { renderEntryArticle } from "@cloudhal/astro-renderer/markdown";
import { getSource } from "@cloudhal/astro-renderer/runtime";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const source = await getSource(config);
  return (await source.entries("posts")).map((e) => ({ params: { slug: e.slug } }));
}

const source = await getSource(config, Astro);
if (!source) return new Response("This site has not been published yet.", { status: 503 });
const site = await source.site();
const entry = await source.entryBySlug("posts", Astro.params.slug as string);
if (!entry) return new Response(null, { status: 404 });
const html = renderEntryArticle(entry, site.defaultLocale);
---
<Base site={site} title={entry.title} description={entry.summary}>
  <Fragment set:html={html} />
</Base>
