---
/**
 * One route for the whole graph: a Page answers at its `path`; an article at
 * `/<collection>/<slug>`. Pages win, so a page is never shadowed by an article.
 */
import config from "virtual:cloudhal/config";
import { Sections } from "@cloudhal/astro-renderer/components";
import { renderEntryArticle } from "@cloudhal/astro-renderer/markdown";
import { navLinks, resolvePath, routablePaths } from "@cloudhal/astro-renderer/routing";
import { getSource } from "@cloudhal/astro-renderer/runtime";
import { entryHead, pageHead, siteOrigin } from "@cloudhal/astro-renderer/seo";
import Base from "../layouts/Base.astro";
import { components } from "../theme.ts";

export async function getStaticPaths() {
  const source = await getSource(config);
  return (await routablePaths(source)).map((path) => ({
    params: { path: path === "/" ? undefined : path.slice(1) },
  }));
}

const source = await getSource(config, Astro);
if (!source) return new Response("This site has not been published yet.", { status: 503 });
const site = await source.site();
const path = Astro.params.path ? `/${Astro.params.path}` : "/";
const resolved = await resolvePath(source, path);
if (!resolved) return new Response(null, { status: 404 });

const origin = siteOrigin(site, Astro.url);
const nav = navLinks(site, await source.pages(), path);

let entries: Record<string, Awaited<ReturnType<typeof source.entries>>> = {};
if (resolved.kind === "page") {
  const collections = [
    ...new Set(
      resolved.page.sections.filter((s) => s.kind === "contentList").map((s) => s.collection),
    ),
  ];
  entries = Object.fromEntries(
    await Promise.all(collections.map(async (c) => [c, await source.entries(c)])),
  );
}
const meta =
  resolved.kind === "page"
    ? pageHead(site, resolved.page, origin)
    : entryHead(site, resolved.entry, origin);
---
<Base site={site} meta={meta} nav={nav}>
  {resolved.kind === "page" ? (
    <Sections sections={resolved.page.sections} entries={entries} components={components} />
  ) : (
    <Fragment set:html={renderEntryArticle(resolved.entry, site.defaultLocale)} />
  )}
</Base>
