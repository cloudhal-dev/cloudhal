{
  "name": "@cloudhal/comments",
  "version": "0.3.9",
  "description": "Cloudhal reader comments (RFC-0007): settings and thread state, text normalising and content rules, linkify, first-party proof of work, the submission pipeline, purge planner, retention plan and the SQLite/D1 store. Worker-safe.",
  "license": "Apache-2.0",
  "homepage": "https://cloudhal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudhal-dev/cloudhal.git",
    "directory": "packages/comments"
  },
  "bugs": {
    "url": "https://github.com/cloudhal-dev/cloudhal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sql": "./src/sql/index.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing.ts",
    "./fixtures/*": "./src/fixtures/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/core-ts": "workspace:*",
    "@cloudhal/storage": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./sql": {
        "types": "./dist/src/sql/index.d.ts",
        "default": "./dist/src/sql/index.js"
      },
      "./client": {
        "types": "./dist/src/client/index.d.ts",
        "default": "./dist/src/client/index.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "default": "./dist/src/testing.js"
      },
      "./fixtures/*": "./dist/src/fixtures/*"
    }
  }
}
