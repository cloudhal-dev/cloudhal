// Test-only playground Worker (RFC-0036 phase 3), run by test/playground-workerd.test.ts.
{
  "name": "playground-test",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "PLAYGROUND", "class_name": "PlaygroundSite" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaygroundSite"] }],
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  "vars": { "PLAYGROUND_DAILY_SESSIONS": "1000" }
}
