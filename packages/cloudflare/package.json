{
  "name": "@cloudhal/cloudflare",
  "version": "0.0.1",
  "description": "Cloudhal on Cloudflare: the admin Worker (API, auth, MCP, Studio) over D1 + R2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudhal-dev/cloudhal",
    "directory": "packages/cloudflare"
  },
  "type": "module",
  "exports": {
    "./admin": "./src/admin-worker.ts",
    "./workerd-prelude": "./src/workerd-prelude.ts",
    "./purge": "./src/purge.ts",
    "./comments": "./src/comments.ts",
    "./scheduler": "./src/scheduler.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/agent-runtime": "workspace:*",
    "@cloudhal/analytics": "workspace:*",
    "@cloudhal/api": "workspace:*",
    "@cloudhal/comments": "workspace:*",
    "@cloudhal/core-ts": "workspace:*",
    "@cloudhal/schedules": "workspace:*",
    "@cloudhal/storage": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./admin": {
        "types": "./dist/src/admin-worker.d.ts",
        "default": "./dist/src/admin-worker.js"
      },
      "./workerd-prelude": {
        "types": "./dist/src/workerd-prelude.d.ts",
        "default": "./dist/src/workerd-prelude.js"
      },
      "./purge": {
        "types": "./dist/src/purge.d.ts",
        "default": "./dist/src/purge.js"
      },
      "./comments": {
        "types": "./dist/src/comments.d.ts",
        "default": "./dist/src/comments.js"
      },
      "./scheduler": {
        "types": "./dist/src/scheduler.d.ts",
        "default": "./dist/src/scheduler.js"
      }
    }
  }
}
