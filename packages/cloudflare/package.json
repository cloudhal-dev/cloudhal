{
  "name": "@cloudhal/cloudflare",
  "version": "0.0.1",
  "description": "Cloudhal on Cloudflare: the admin Worker (API, auth, MCP, Studio) over D1 + R2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudhal-dev/cloudhal",
    "directory": "packages/cloudflare"
  },
  "type": "module",
  "exports": {
    "./admin": "./src/admin-worker.ts",
