{
  "name": "@cloudhal/analytics",
  "version": "0.3.6",
  "description": "Cloudhal site analytics (RFC-0006): query model, classifiers, beacon handler, SQLite/D1 store, daily rollups and Workers Analytics Engine adapters. Worker-safe.",
  "license": "Apache-2.0",
  "homepage": "https://cloudhal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudhal-dev/cloudhal.git",
    "directory": "packages/analytics"
  },
  "bugs": {
    "url": "https://github.com/cloudhal-dev/cloudhal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sql": "./src/sql/index.ts",
    "./rollup": "./src/rollup.ts",
    "./reader": "./src/reader.ts",
    "./service": "./src/service.ts",
    "./wae": "./src/wae/index.ts",
    "./testing": "./src/testing.ts",
    "./client": "./src/client/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/storage": "workspace:*",
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./sql": {
        "types": "./dist/src/sql/index.d.ts",
        "default": "./dist/src/sql/index.js"
      },
      "./rollup": {
        "types": "./dist/src/rollup.d.ts",
        "default": "./dist/src/rollup.js"
      },
      "./reader": {
        "types": "./dist/src/reader.d.ts",
        "default": "./dist/src/reader.js"
      },
      "./service": {
        "types": "./dist/src/service.d.ts",
        "default": "./dist/src/service.js"
      },
      "./wae": {
        "types": "./dist/src/wae/index.d.ts",
        "default": "./dist/src/wae/index.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "default": "./dist/src/testing.js"
      },
      "./client": {
        "types": "./dist/src/client/index.d.ts",
        "default": "./dist/src/client/index.js"
      }
    }
  }
}
