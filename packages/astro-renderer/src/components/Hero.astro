---
import type { HeroSection } from "@cloudhal/core-contracts";

interface Props {
  section: HeroSection;
}
const { section } = Astro.props;
---
<section class="ch-hero" data-section-id={section.id} data-kind="hero">
  <h1>{section.heading}</h1>
  {section.subheading && <p class="ch-hero__sub">{section.subheading}</p>}
  {section.image && <img src={section.image.src} alt={section.image.alt} width={section.image.width} height={section.image.height} />}
  {section.cta && <a class="ch-hero__cta" href={section.cta.href} rel={section.cta.external ? "noopener" : undefined}>{section.cta.label}</a>}
</section>
