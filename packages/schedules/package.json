{
  "name": "@cloudhal/schedules",
  "version": "0.1.0",
  "description": "Cloudhal schedules (RFC-0008): the time model, the RRULE subset and its sentences, releases (pin, closure, rl1: hash, compose, conflicts, state machine), automation and run state, taint and budget accounting, the Scheduler and runDue, and the SQLite/D1 store. Worker-safe.",
  "license": "Apache-2.0",
  "homepage": "https://cloudhal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudhal-dev/cloudhal.git",
    "directory": "packages/schedules"
  },
  "bugs": {
    "url": "https://github.com/cloudhal-dev/cloudhal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./time": "./src/time-entry.ts",
    "./recurrence": "./src/recurrence.ts",
    "./sql": "./src/sql/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/storage": "workspace:*",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "miniflare": "catalog:",
    "rrule-temporal": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./engine": {
        "types": "./dist/src/engine.d.ts",
        "default": "./dist/src/engine.js"
      },
      "./time": {
        "types": "./dist/src/time-entry.d.ts",
        "default": "./dist/src/time-entry.js"
      },
      "./recurrence": {
        "types": "./dist/src/recurrence.d.ts",
        "default": "./dist/src/recurrence.js"
      },
      "./sql": {
        "types": "./dist/src/sql/index.d.ts",
        "default": "./dist/src/sql/index.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "default": "./dist/src/testing.js"
      }
    }
  }
}
