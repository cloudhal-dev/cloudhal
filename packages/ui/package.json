{
  "name": "@cloudhal/ui",
  "version": "0.0.1",
  "description": "Cloudhal admin UI kit: Kumo (Cloudflare) re-exported plus Cloudhal blocks (StatusBadge, SnapshotTimeline, ApprovalDialog)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudhal-dev/cloudhal",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "./src/blocks/charts.ts",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./code": "./src/code.ts",
    "./charts": "./src/charts.ts",
    "./editor": "./src/editor.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudflare/kumo": "catalog:",
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/core-ts": "workspace:*",
    "@cloudhal/messages": "workspace:*",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "echarts": "catalog:",
    "marked": "catalog:"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "private": true
}
