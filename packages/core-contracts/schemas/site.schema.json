{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudhal.dev/schemas/v1/site.schema.json",
  "title": "Site",
  "description": "Root node of a Site Graph: one deployable website with its locales, domains, theme and page index. Pages and content entries are separate nodes referenced by id so they can be versioned and locked independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "name",
    "slug",
    "defaultLocale",
    "locales",
    "domains",
    "pageIds",
    "theme",
    "rev",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "projectId": { "$ref": "common.schema.json#/$defs/Id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "defaultLocale": { "$ref": "common.schema.json#/$defs/Locale" },
    "locales": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Locale" },
      "minItems": 1,
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "description": "Hostnames serving this site. Exactly one should be primary: the address canonical links, feeds and previews use. Sites run on their own domains or their Cloudflare account's workers.dev address, never on a Cloudhal domain (ADR-0037).",
      "items": { "$ref": "#/$defs/Domain" }
    },
    "pageIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Id" },
      "uniqueItems": true
    },
    "homePageId": { "$ref": "common.schema.json#/$defs/Id" },
    "localization": { "$ref": "#/$defs/Localization" },
    "theme": { "$ref": "#/$defs/ThemeRef" },
    "design": { "$ref": "#/$defs/Design" },
    "brand": { "$ref": "#/$defs/Brand" },
    "chrome": { "$ref": "#/$defs/Chrome" },
    "timeZone": {
      "$ref": "common.schema.json#/$defs/TimeZone",
      "description": "The site's time zone (RFC-0008): Studio's calendar, schedules entered as wall-clock times and recurring automations use it. Absent means UTC."
    },
    "publishedSnapshotId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Snapshot currently serving production. Rollback = pointing this at an older snapshot."
    },
    "rev": { "$ref": "common.schema.json#/$defs/Revision" },
    "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
  },
  "$defs": {
    "Brand": {
      "type": "object",
      "description": "The site's logo and social links (RFC-0025 \u00a71), shared by the header, the footer and SEO.",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "$ref": "common.schema.json#/$defs/ImageRef"
        },
        "logoDark": {
          "$ref": "common.schema.json#/$defs/ImageRef"
        },
        "logoHeight": {
          "type": "string",
          "enum": ["s", "m", "l"]
        },
        "social": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/SocialLink"
          }
        }
      }
    },
    "SocialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "href"],
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "x",
            "bluesky",
            "mastodon",
            "github",
            "linkedin",
            "instagram",
            "facebook",
            "youtube",
            "tiktok",
            "threads",
            "rss",
            "email"
          ]
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "Chrome": {
      "type": "object",
      "description": "The site's header, footer and bars as data (RFC-0025): enums, menu keys and short texts; the theme renders them with landmarks, focus and contrast guaranteed.",
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/ChromeHeader"
        },
        "footer": {
          "$ref": "#/$defs/ChromeFooter"
        },
        "announcement": {
          "$ref": "#/$defs/Announcement"
        },
        "consent": {
          "$ref": "#/$defs/Consent"
        }
      }
    },
    "ChromeHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["logo-left", "logo-left-nav-center", "centered", "split", "minimal"]
        },
        "behavior": {
          "type": "string",
          "enum": ["static", "sticky", "hide-on-scroll", "fixed"]
        },
        "shrink": {
          "type": "boolean"
        },
        "overHero": {
          "type": "string",
          "enum": ["solid", "transparent"]
        },
        "width": {
          "type": "string",
          "enum": ["content", "wide", "full"]
        },
        "surface": {
          "type": "string",
          "enum": ["plain", "muted", "raised", "inverse", "brand"]
        },
        "mobileStyle": {
          "type": "string",
          "enum": ["dropdown", "drawer-start", "drawer-end", "fullscreen"]
        },
        "collapseAt": {
          "type": "string",
          "enum": ["sm", "md", "lg", "always"]
        },
        "nav": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "utility": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/HeaderAction"
          }
        }
      }
    },
    "HeaderAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["button", "search", "locale", "theme-toggle", "motion-toggle"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary"]
        }
      }
    },
    "ChromeFooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["simple", "columns", "cta-band", "minimal"]
        },
        "surface": {
          "type": "string",
          "enum": ["plain", "muted", "inverse"]
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "columns": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/FooterColumn"
          }
        },
        "ctaHeading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ctaHref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "social": {
          "type": "boolean"
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The legal line; {year} and {site} are the only placeholders."
        },
        "legal": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "extras": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["locale", "theme-toggle", "motion-toggle"]
          }
        },
        "credit": {
          "type": "boolean"
        },
        "region": {
          "$ref": "section.schema.json",
          "description": "RFC-0025 §2: one optional surface (kind `surface`) above the footer's columns, built and checked like any surface; the store refuses other section kinds."
        }
      }
    },
    "FooterColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "menu"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "menu": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        }
      }
    },
    "Announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
          "description": "Change it when the text changes, so readers who dismissed the old one see the new one."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tone": {
          "type": "string",
          "enum": ["info", "brand", "warning"]
        },
        "dismissible": {
          "type": "boolean"
        }
      }
    },
    "Consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "notice", "choices"]
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/Path"
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "primary"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "maxLength": 253
        },
        "primary": { "type": "boolean" }
      }
    },
    "Localization": {
      "type": "object",
      "description": "How the site serves its locales (RFC-0033 §2). Absent fields mean: prefix-except-default routing, no fallback, no required review, the machine-translation notice until reviewed.",
      "additionalProperties": false,
      "properties": {
        "routing": {
          "type": "string",
          "description": "prefix-except-default: the default locale at the root, the others under /<locale>/. prefix-all: every locale prefixed, / is a language chooser (x-default).",
          "enum": ["prefix-except-default", "prefix-all"]
        },
        "domains": {
          "type": "object",
          "description": "Optional hostname per locale; that locale is then served at the host's root.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Locale" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
            "maxLength": 253
          }
        },
        "fallback": {
          "type": "string",
          "description": "none: a missing translation is not found. default-with-notice: the default locale's page is served with a notice and noindex.",
          "enum": ["none", "default-with-notice"]
        },
        "review": {
          "type": "object",
          "description": "Collections whose machine translations need a person's review before they publish ('pages' stands for pages).",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 100 },
              "uniqueItems": true
            }
          }
        },
        "label": {
          "type": "string",
          "description": "When readers see the machine-translation notice: unreviewed (until a person reviews) or always.",
          "enum": ["unreviewed", "always"]
        }
      }
    },
    "Design": {
      "type": "object",
      "description": "The site's design rules for people and agents (RFC-0021): Markdown that agents read with the theme's DESIGN.md before they build. Guidance only: it changes neither rendering nor permissions.",
      "additionalProperties": false,
      "required": ["markdown"],
      "properties": {
        "markdown": { "type": "string", "minLength": 1, "maxLength": 24000 }
      }
    },
    "ThemeRef": {
      "type": "object",
      "description": "Theme (a.k.a. Experience) applied by the renderer. Config is theme-defined and validated by the theme's own schema, not here.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/Slug" },
        "version": { "type": "string", "maxLength": 64 },
        "config": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
