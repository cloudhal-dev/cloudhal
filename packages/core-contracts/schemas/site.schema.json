{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudhal.dev/schemas/v1/site.schema.json",
  "title": "Site",
  "description": "Root node of a Site Graph: one deployable website with its locales, domains, theme and page index. Pages and content entries are separate nodes referenced by id so they can be versioned and locked independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "name",
    "slug",
    "defaultLocale",
    "locales",
    "domains",
    "pageIds",
    "theme",
    "rev",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "projectId": { "$ref": "common.schema.json#/$defs/Id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "defaultLocale": { "$ref": "common.schema.json#/$defs/Locale" },
    "locales": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Locale" },
      "minItems": 1,
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "description": "Hostnames serving this site. Exactly one should be primary: the address canonical links, feeds and previews use. Sites run on their own domains or their Cloudflare account's workers.dev address, never on a Cloudhal domain (ADR-0037).",
      "items": { "$ref": "#/$defs/Domain" }
    },
    "pageIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Id" },
      "uniqueItems": true
    },
    "homePageId": { "$ref": "common.schema.json#/$defs/Id" },
    "localization": { "$ref": "#/$defs/Localization" },
    "collections": {
      "type": "object",
      "description": "RFC-0038, RFC-0040: the site's declared collections and their settings, keyed by collection (ContentEntry.collection). A key here declares the collection, even with no settings ({}). A collection with entries but no key is inferred and uses the defaults.",
      "propertyNames": { "$ref": "common.schema.json#/$defs/Slug" },
      "maxProperties": 50,
      "additionalProperties": { "$ref": "#/$defs/CollectionSettings" }
    },
    "theme": { "$ref": "#/$defs/ThemeRef" },
    "design": { "$ref": "#/$defs/Design" },
    "brand": { "$ref": "#/$defs/Brand" },
    "chrome": { "$ref": "#/$defs/Chrome" },
    "timeZone": {
      "$ref": "common.schema.json#/$defs/TimeZone",
      "description": "The site's time zone (RFC-0008): Studio's calendar, schedules entered as wall-clock times and recurring automations use it. Absent means UTC."
    },
    "publishedSnapshotId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Snapshot currently serving production. Rollback = pointing this at an older snapshot."
    },
    "rev": { "$ref": "common.schema.json#/$defs/Revision" },
    "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
  },
  "$defs": {
    "CollectionSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permalink": {
          "type": "string",
          "description": "RFC-0038: where the collection's entries live, as a template with a closed token set. Version 1: one or more fixed lower-case path segments followed by /{slug}, e.g. /blog/{slug}. Absent means /<collection>/{slug}.",
          "pattern": "^(/[a-z0-9]+(-[a-z0-9]+)*)+/\\{slug\\}$"
        },
        "labels": {
          "type": "object",
          "description": "RFC-0040: display names per locale (Studio, agents, themes). Absent or missing a locale: the default locale's, then the key.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Locale" },
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/CollectionLabel" }
        },
        "icon": {
          "type": "string",
          "description": "RFC-0040: a name from Studio's closed icon set (e.g. calendar, briefcase, users). Unknown names show the default icon. Never a URL or markup.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 40
        },
        "feed": {
          "type": "boolean",
          "description": "RFC-0040: entries appear in the site's RSS feeds. Absent: true."
        },
        "sitemap": {
          "type": "boolean",
          "description": "RFC-0040: published entries appear in sitemap.xml. Absent: true."
        },
        "sort": {
          "type": "string",
          "description": "RFC-0040: default order where none is given (Studio's list, entry queries without sort, MCP list_entries). Absent: newest.",
          "enum": ["newest", "oldest", "title"]
        },
        "fields": {
          "type": "array",
          "description": "RFC-0041: the collection's typed custom fields, in form order. Values live in ContentEntry.fields under each key. At most 200 per site and unique keys (checked in code).",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          }
        },
        "listFields": {
          "type": "array",
          "description": "RFC-0042: fields that listings, queries, Studio columns and MCP may filter and sort by, in column order. Keys of this collection's fields (checked in code).",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FieldKey"
          }
        },
        "expiry": {
          "$ref": "#/$defs/CollectionExpiry"
        },
        "structuredData": {
          "$ref": "#/$defs/StructuredDataPreset"
        }
      }
    },
    "CollectionExpiry": {
      "type": "object",
      "description": "RFC-0042: a time gate every entry derives from one of its date or datetime fields, checked at render time like Availability.until. A date ends at the start of the next day in the site's time zone.",
      "additionalProperties": false,
      "required": ["field", "action"],
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldKey"
        },
        "action": {
          "type": "string",
          "description": "unlist: the page stays, the entry leaves listings, feeds, the sitemap and search. hide: every public route answers 404.",
          "enum": ["unlist", "hide"]
        },
        "afterMinutes": {
          "type": "integer",
          "description": "Grace after the field's instant. Absent: 0.",
          "minimum": 0,
          "maximum": 10080
        }
      }
    },
    "StructuredDataPreset": {
      "type": "object",
      "description": "RFC-0042: the JSON-LD type an entry page emits in place of BlogPosting, with its properties mapped to value sources. Paths, fitting field types and required properties are a closed table in code (@cloudhal/core-ts/structured-data).",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Event", "JobPosting", "Product", "Recipe"]
        },
        "properties": {
          "type": "object",
          "description": "Keyed by property path, e.g. startDate or location.address.addressLocality.",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z]{0,39}(\\.[a-z][A-Za-z]{0,39}){0,2}$"
          },
          "minProperties": 1,
          "maxProperties": 40,
          "additionalProperties": {
            "$ref": "#/$defs/StructuredDataSource"
          }
        }
      }
    },
    "StructuredDataSource": {
      "description": "RFC-0042: where one JSON-LD property's value comes from, discriminated by `kind`.",
      "oneOf": [
        {
          "title": "FieldValueSource",
          "type": "object",
          "description": "A typed field of this collection, converted by its type.",
          "additionalProperties": false,
          "required": ["kind", "field"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["field"]
            },
            "field": {
              "$ref": "#/$defs/FieldKey"
            }
          }
        },
        {
          "title": "EntryValueSource",
          "type": "object",
          "description": "A built-in property of the entry.",
          "additionalProperties": false,
          "required": ["kind", "property"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["entry"]
            },
            "property": {
              "$ref": "#/$defs/EntryValueProperty"
            }
          }
        },
        {
          "title": "SiteValueSource",
          "type": "object",
          "description": "A property of the site.",
          "additionalProperties": false,
          "required": ["kind", "property"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["site"]
            },
            "property": {
              "$ref": "#/$defs/SiteValueProperty"
            }
          }
        },
        {
          "title": "TextValueSource",
          "type": "object",
          "description": "A plain-text constant: no control characters, no markup meaning; vocabulary-checked on enum paths (in code).",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["text"]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\x00-\\x1F\\x7F]+$"
            }
          }
        }
      ]
    },
    "EntryValueProperty": {
      "type": "string",
      "description": "RFC-0042: entry properties a structured-data property may read.",
      "enum": ["title", "summary", "body", "coverImage", "url", "publishedAt", "updatedAt"]
    },
    "SiteValueProperty": {
      "type": "string",
      "description": "RFC-0042: site properties a structured-data property may read.",
      "enum": ["name", "url", "logo"]
    },
    "CollectionLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singular", "plural"],
      "properties": {
        "singular": { "type": "string", "minLength": 1, "maxLength": 100 },
        "plural": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "FieldDefinition": {
      "description": "RFC-0041: one typed custom field of a collection, discriminated by `type`.",
      "oneOf": [
        {
          "title": "TextField",
          "type": "object",
          "description": "Plain text: a string of at most maxLength characters.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["text"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            },
            "maxLength": {
              "type": "integer",
              "description": "Absent: 5000.",
              "minimum": 1,
              "maximum": 5000
            },
            "multiline": {
              "type": "boolean",
              "description": "Line breaks allowed. Absent: false."
            },
            "searchable": {
              "type": "boolean",
              "description": "Its words go into site search. Absent: false."
            }
          }
        },
        {
          "title": "RichTextField",
          "type": "object",
          "description": "Cloudhal Markdown v1 (ADR-0028), at most 50 000 characters.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["richText"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            },
            "searchable": {
              "type": "boolean",
              "description": "Its words go into site search. Absent: false."
            }
          }
        },
        {
          "title": "NumberField",
          "type": "object",
          "description": "A finite number.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["number"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            },
            "integer": {
              "type": "boolean",
              "description": "Whole numbers only. Absent: false."
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "title": "BooleanField",
          "type": "object",
          "description": "true or false; absent reads as false, so it cannot be required to publish.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["boolean"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            }
          }
        },
        {
          "title": "DateField",
          "type": "object",
          "description": "A calendar day without a zone (YYYY-MM-DD).",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["date"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            }
          }
        },
        {
          "title": "DateTimeField",
          "type": "object",
          "description": "An instant with the zone it was entered in: {at, timeZone} (RFC-0008 §9.1).",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["datetime"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            }
          }
        },
        {
          "title": "UrlField",
          "type": "object",
          "description": "A link: https, http, mailto, tel, a site-relative path or a #fragment; at most 2048 characters.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["url"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            }
          }
        },
        {
          "title": "ImageField",
          "type": "object",
          "description": "An image Asset of the same site, by id (asset_…).",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["image"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            }
          }
        },
        {
          "title": "SelectField",
          "type": "object",
          "description": "One of a closed list of options, or several when multiple.",
          "additionalProperties": false,
          "required": ["key", "type", "labels", "localized", "options"],
          "properties": {
            "key": {
              "$ref": "#/$defs/FieldKey"
            },
            "type": {
              "type": "string",
              "enum": ["select"]
            },
            "labels": {
              "$ref": "#/$defs/FieldLabels"
            },
            "localized": {
              "type": "boolean",
              "description": "true: each language version has its own value (missing reads the original's); false: only the translation group's original holds it."
            },
            "requiredToPublish": {
              "type": "boolean",
              "description": "An entry in review or published needs a value. Absent: false."
            },
            "migration": {
              "$ref": "#/$defs/FieldMigration"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "$ref": "#/$defs/FieldOption"
              }
            },
            "multiple": {
              "type": "boolean",
              "description": "The value is a list of option values. Absent: false."
            }
          }
        }
      ]
    },
    "FieldKey": {
      "type": "string",
      "description": "The field's key in ContentEntry.fields: lower camelCase, a JavaScript identifier. Unique in its collection; built-in entry property names are reserved (checked in code).",
      "pattern": "^[a-z][A-Za-z0-9]{0,39}$"
    },
    "FieldLabels": {
      "type": "object",
      "description": "The field's label and help per locale. Missing a locale: the default locale's, then the key.",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Locale"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/FieldLabel"
      }
    },
    "FieldLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "help": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "FieldOption": {
      "type": "object",
      "description": "One option of a select field. Values are unique in the field (checked in code).",
      "additionalProperties": false,
      "required": ["value", "labels"],
      "properties": {
        "value": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "Stored in entries, never shown."
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Locale"
          },
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "FieldMigration": {
      "type": "object",
      "description": "RFC-0041 §6: present only while a field operation rewrites entries.",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id",
          "description": "The operation's \"before\" snapshot."
        },
        "fromKey": {
          "$ref": "#/$defs/FieldKey"
        },
        "fromType": {
          "type": "string",
          "enum": [
            "text",
            "richText",
            "number",
            "boolean",
            "date",
            "datetime",
            "url",
            "image",
            "select"
          ]
        },
        "fromLocalized": {
          "type": "boolean"
        }
      }
    },
    "Brand": {
      "type": "object",
      "description": "The site's logo and social links (RFC-0025 \u00a71), shared by the header, the footer and SEO.",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "$ref": "common.schema.json#/$defs/ImageRef"
        },
        "logoDark": {
          "$ref": "common.schema.json#/$defs/ImageRef"
        },
        "logoHeight": {
          "type": "string",
          "enum": ["s", "m", "l"]
        },
        "social": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/SocialLink"
          }
        }
      }
    },
    "SocialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "href"],
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "x",
            "bluesky",
            "mastodon",
            "github",
            "linkedin",
            "instagram",
            "facebook",
            "youtube",
            "tiktok",
            "threads",
            "rss",
            "email"
          ]
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "Chrome": {
      "type": "object",
      "description": "The site's header, footer and bars as data (RFC-0025): enums, menu keys and short texts; the theme renders them with landmarks, focus and contrast guaranteed.",
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/ChromeHeader"
        },
        "footer": {
          "$ref": "#/$defs/ChromeFooter"
        },
        "announcement": {
          "$ref": "#/$defs/Announcement"
        },
        "consent": {
          "$ref": "#/$defs/Consent"
        }
      }
    },
    "ChromeHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["logo-left", "logo-left-nav-center", "centered", "split", "minimal"]
        },
        "behavior": {
          "type": "string",
          "enum": ["static", "sticky", "hide-on-scroll", "fixed"]
        },
        "shrink": {
          "type": "boolean"
        },
        "overHero": {
          "type": "string",
          "enum": ["solid", "transparent"]
        },
        "width": {
          "type": "string",
          "enum": ["content", "wide", "full"]
        },
        "surface": {
          "type": "string",
          "enum": ["plain", "muted", "raised", "inverse", "brand"]
        },
        "mobileStyle": {
          "type": "string",
          "enum": ["dropdown", "drawer-start", "drawer-end", "fullscreen"]
        },
        "collapseAt": {
          "type": "string",
          "enum": ["sm", "md", "lg", "always"]
        },
        "nav": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "utility": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/HeaderAction"
          }
        }
      }
    },
    "HeaderAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["button", "search", "locale", "theme-toggle", "motion-toggle"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary"]
        }
      }
    },
    "ChromeFooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["simple", "columns", "cta-band", "minimal"]
        },
        "surface": {
          "type": "string",
          "enum": ["plain", "muted", "inverse"]
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "columns": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/FooterColumn"
          }
        },
        "ctaHeading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ctaHref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "social": {
          "type": "boolean"
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The legal line; {year} and {site} are the only placeholders."
        },
        "legal": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        },
        "extras": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["locale", "theme-toggle", "motion-toggle"]
          }
        },
        "credit": {
          "type": "boolean"
        },
        "region": {
          "$ref": "section.schema.json",
          "description": "RFC-0025 §2: one optional surface (kind `surface`) above the footer's columns, built and checked like any surface; the store refuses other section kinds."
        }
      }
    },
    "FooterColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "menu"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "menu": {
          "$ref": "common.schema.json#/$defs/Slug",
          "description": "A menu key (RFC-0003)."
        }
      }
    },
    "Announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
          "description": "Change it when the text changes, so readers who dismissed the old one see the new one."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tone": {
          "type": "string",
          "enum": ["info", "brand", "warning"]
        },
        "dismissible": {
          "type": "boolean"
        }
      }
    },
    "Consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "notice", "choices"]
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/Path"
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "primary"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "maxLength": 253
        },
        "primary": { "type": "boolean" }
      }
    },
    "Localization": {
      "type": "object",
      "description": "How the site serves its locales (RFC-0033 §2). Absent fields mean: prefix-except-default routing, no fallback, no required review, the machine-translation notice until reviewed.",
      "additionalProperties": false,
      "properties": {
        "routing": {
          "type": "string",
          "description": "prefix-except-default: the default locale at the root, the others under /<locale>/. prefix-all: every locale prefixed, / is a language chooser (x-default).",
          "enum": ["prefix-except-default", "prefix-all"]
        },
        "domains": {
          "type": "object",
          "description": "Optional hostname per locale; that locale is then served at the host's root.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Locale" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
            "maxLength": 253
          }
        },
        "fallback": {
          "type": "string",
          "description": "none: a missing translation is not found. default-with-notice: the default locale's page is served with a notice and noindex.",
          "enum": ["none", "default-with-notice"]
        },
        "review": {
          "type": "object",
          "description": "Collections whose machine translations need a person's review before they publish ('pages' stands for pages).",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 100 },
              "uniqueItems": true
            }
          }
        },
        "label": {
          "type": "string",
          "description": "When readers see the machine-translation notice: unreviewed (until a person reviews) or always.",
          "enum": ["unreviewed", "always"]
        }
      }
    },
    "Design": {
      "type": "object",
      "description": "The site's design rules for people and agents (RFC-0021): Markdown that agents read with the theme's DESIGN.md before they build. Guidance only: it changes neither rendering nor permissions.",
      "additionalProperties": false,
      "required": ["markdown"],
      "properties": {
        "markdown": { "type": "string", "minLength": 1, "maxLength": 24000 }
      }
    },
    "ThemeRef": {
      "type": "object",
      "description": "Theme (a.k.a. Experience) applied by the renderer. Config is theme-defined and validated by the theme's own schema, not here.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/Slug" },
        "version": { "type": "string", "maxLength": 64 },
        "config": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
