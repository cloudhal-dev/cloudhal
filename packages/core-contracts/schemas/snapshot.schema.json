{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudhal.dev/schemas/v1/snapshot.schema.json",
  "title": "Snapshot",
  "description": "Immutable record of a site's node set at one instant: which nodes existed, at which revision, with which content hash. Every mutation by an agent produces one; publish and rollback point the site at one. Node bodies are stored by hash in the blob store, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "siteId",
    "siteRev",
    "reason",
    "actor",
    "nodes",
    "summary",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "siteId": { "$ref": "common.schema.json#/$defs/Id" },
    "parentId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Previous snapshot in this site's history; absent for the first one."
    },
    "siteRev": { "$ref": "common.schema.json#/$defs/Revision" },
    "reason": {
      "type": "string",
      "enum": ["manual", "agentMutation", "publish", "rollback", "scheduled", "import"]
    },
    "label": { "type": "string", "maxLength": 200 },
    "actor": { "$ref": "common.schema.json#/$defs/Actor" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/NodeRef" }
    },
    "summary": { "$ref": "#/$defs/ChangeSummary" },
    "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
  },
  "$defs": {
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "rev", "hash"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": {
          "type": "string",
          "enum": ["site", "page", "contentEntry", "taxonomy", "term", "redirect"]
        },
        "rev": { "$ref": "common.schema.json#/$defs/Revision" },
        "hash": {
          "type": "string",
          "description": "Lower-case hex SHA-256 of the node's canonical JSON.",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ChangeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "removed"],
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
