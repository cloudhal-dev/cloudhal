{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudhal.dev/schemas/v1/content-entry.schema.json",
  "title": "ContentEntry",
  "description": "A structured content item in a named collection (e.g. collection 'posts'). Core fields are typed; collection-specific fields live in `fields` and are validated by the collection's own schema in a later phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "siteId",
    "collection",
    "slug",
    "locale",
    "status",
    "title",
    "body",
    "fields",
    "tags",
    "author",
    "rev",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "siteId": { "$ref": "common.schema.json#/$defs/Id" },
    "collection": { "$ref": "common.schema.json#/$defs/Slug" },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "locale": { "$ref": "common.schema.json#/$defs/Locale" },
    "status": { "$ref": "common.schema.json#/$defs/PublishStatus" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 2000 },
    "body": { "$ref": "#/$defs/Body" },
    "fields": {
      "type": "object",
      "description": "Collection-specific values; any JSON.",
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "description": "Deprecated by RFC-0002: use `terms.tag`. Still accepted on input for one release and translated into terms; the store then writes []. Removed in schemaVersion 2.",
      "deprecated": true,
      "items": { "$ref": "common.schema.json#/$defs/Slug" },
      "uniqueItems": true,
      "maxItems": 50
    },
    "terms": {
      "type": "object",
      "description": "Term assignments by taxonomy key (e.g. 'category', 'tag'). Terms are referenced by id, independent of locale. A taxonomy without terms is omitted, never an empty object.",
      "propertyNames": { "$ref": "common.schema.json#/$defs/Slug" },
      "minProperties": 1,
      "maxProperties": 10,
      "additionalProperties": { "$ref": "#/$defs/TermAssignment" }
    },
    "author": { "$ref": "common.schema.json#/$defs/Actor" },
    "coverImage": { "$ref": "common.schema.json#/$defs/ImageRef" },
    "publishedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "availability": { "$ref": "common.schema.json#/$defs/Availability" },
    "rev": { "$ref": "common.schema.json#/$defs/Revision" },
    "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
  },
  "$defs": {
    "TermAssignment": {
      "type": "object",
      "description": "Terms of one taxonomy on one entry, in display order. The primary term is explicit and never derived from the order.",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Id" },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "primary": {
          "$ref": "common.schema.json#/$defs/Id",
          "description": "The entry's main term in this taxonomy (breadcrumbs, articleSection, later permalinks). Must be one of `ids`."
        }
      }
    },
    "Body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "value"],
      "properties": {
        "format": { "type": "string", "enum": ["markdown", "html"] },
        "value": { "type": "string", "maxLength": 1000000 },
        "profile": { "$ref": "common.schema.json#/$defs/BodyProfile" },
        "blocks": { "$ref": "common.schema.json#/$defs/BodyBlocks" }
      }
    }
  }
}
