{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudhal.dev/schemas/v1/release-yank-list.schema.json",
  "title": "ReleaseYankList",
  "description": "cloudhal.release-yank-list@1 (RFC-0046 \u00a79): the yank list, published as yanked.json at https://cloudhal.dev/.well-known/cloudhal/yanked.json next to yanked.json.sig (a raw 64-byte Ed25519 signature by a yank-role key from keys.json over the exact bytes). It only reduces trust: versions no consumer may install, and release key ids every consumer must refuse. Re-signed weekly; it expires 30 days after issuedAt, and a stale list blocks new installs only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "serial",
    "issuedAt",
    "expires",
    "signing",
    "versions",
    "revokedKeys"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "format": {
      "type": "string",
      "enum": ["cloudhal.release-yank-list@1"]
    },
    "serial": {
      "description": "Increases by one at every signing. A consumer that keeps state refuses a serial lower than the last one it saw (a rollback to an older, validly signed list).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "expires": {
      "description": "Exactly 30 days after issuedAt.",
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": {
          "description": "The yank-role key that signed this list.",
          "$ref": "#/$defs/KeyId"
        },
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "signature": {
          "type": "string",
          "enum": ["yanked.json.sig"]
        }
      }
    },
    "versions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "yankedAt", "reason"],
        "properties": {
          "version": {
            "$ref": "#/$defs/CloudhalVersion"
          },
          "yankedAt": {
            "$ref": "common.schema.json#/$defs/Timestamp"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "revokedKeys": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "revokedAt", "reason"],
        "properties": {
          "keyId": {
            "$ref": "#/$defs/KeyId"
          },
          "revokedAt": {
            "$ref": "common.schema.json#/$defs/Timestamp"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "$defs": {
    "KeyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "CloudhalVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    }
  }
}
