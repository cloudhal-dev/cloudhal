{
  "name": "@cloudhal/core-contracts",
  "version": "0.0.1",
  "description": "Cloudhal domain contracts: JSON Schema source of truth plus generated TypeScript types",
  "license": "Apache-2.0",
  "homepage": "https://cloudhal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudhal-dev/cloudhal.git",
    "directory": "packages/core-contracts"
  },
  "bugs": {
    "url": "https://github.com/cloudhal-dev/cloudhal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*",
    "./bundle": "./scripts/bundle.ts"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "bundle": "tsx scripts/bundle.ts",
    "gen:ts": "tsx scripts/gen-ts.ts && tsx scripts/gen-validators.ts",
    "gen:rs": "tsx scripts/gen-rs.ts",
    "gen": "pnpm gen:ts && pnpm gen:rs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./schemas/*": "./schemas/*",
      "./bundle": {
        "types": "./dist/scripts/bundle.d.ts",
        "default": "./dist/scripts/bundle.js"
      }
    }
  }
}
