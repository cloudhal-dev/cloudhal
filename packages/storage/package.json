{
  "name": "@cloudhal/storage",
  "version": "0.0.1",
  "description": "Cloudhal storage interfaces (SQL driver, blob store) with Cloudflare D1/R2 and local SQLite/filesystem adapters",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudhal-dev/cloudhal",
    "directory": "packages/storage"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sqlite": "./src/sql/better-sqlite3.ts",
    "./d1": "./src/sql/d1.ts",
    "./r2": "./src/blob/r2.ts",
    "./fs": "./src/blob/fs.ts",
    "./testing": "./src/testing.ts",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "src",
    "migrations",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/core-contracts": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
