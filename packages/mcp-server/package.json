{
  "name": "@cloudhal/mcp-server",
  "version": "0.0.1",
  "description": "Cloudhal MCP server: semantic site tools (pages, articles, snapshots, preview, publish) governed by the policy engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudhal-dev/cloudhal",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./stdio": "./src/stdio.ts",
    "./http": "./src/http.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/analytics": "workspace:*",
    "@cloudhal/agent-runtime": "workspace:*",
    "@cloudhal/astro-renderer": "workspace:*",
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/core-ts": "workspace:*",
    "@cloudhal/storage": "workspace:*",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@modelcontextprotocol/client": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./tools": {
        "types": "./dist/src/tools.d.ts",
        "default": "./dist/src/tools.js"
      },
      "./stdio": {
        "types": "./dist/src/stdio.d.ts",
        "default": "./dist/src/stdio.js"
      },
      "./http": {
        "types": "./dist/src/http.d.ts",
        "default": "./dist/src/http.js"
      }
    }
  }
}
