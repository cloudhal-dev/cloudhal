{
  "name": "@cloudhal/mcp-server",
  "version": "0.6.1",
  "description": "Cloudhal MCP server: semantic site tools (pages, articles, snapshots, preview, publish) governed by the policy engine",
  "license": "Apache-2.0",
  "homepage": "https://cloudhal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudhal-dev/cloudhal.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/cloudhal-dev/cloudhal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./body": "./src/body-tools.ts",
    "./analytics": "./src/analytics-reports.ts",
    "./comments": "./src/comments.ts",
    "./schedules": "./src/schedules.ts",
    "./render": "./src/render.ts",
    "./stdio": "./src/stdio.ts",
    "./http": "./src/http.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudhal/analytics": "workspace:*",
    "@cloudhal/agent-runtime": "workspace:*",
    "@cloudhal/astro-renderer": "workspace:*",
    "@cloudhal/comments": "workspace:*",
    "@cloudhal/core-contracts": "workspace:*",
    "@cloudhal/core-ts": "workspace:*",
    "@cloudhal/storage": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@cloudhal/schedules": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./tools": {
        "types": "./dist/src/tools.d.ts",
        "default": "./dist/src/tools.js"
      },
      "./body": {
        "types": "./dist/src/body-tools.d.ts",
        "default": "./dist/src/body-tools.js"
      },
      "./analytics": {
        "types": "./dist/src/analytics-reports.d.ts",
        "default": "./dist/src/analytics-reports.js"
      },
      "./comments": {
        "types": "./dist/src/comments.d.ts",
        "default": "./dist/src/comments.js"
      },
      "./schedules": {
        "types": "./dist/src/schedules.d.ts",
        "default": "./dist/src/schedules.js"
      },
      "./render": {
        "types": "./dist/src/render.d.ts",
        "default": "./dist/src/render.js"
      },
      "./stdio": {
        "types": "./dist/src/stdio.d.ts",
        "default": "./dist/src/stdio.js"
      },
      "./http": {
        "types": "./dist/src/http.d.ts",
        "default": "./dist/src/http.js"
      }
    }
  }
}
