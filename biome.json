{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/src/generated",
      "!apps/studio/src/i18n/generated",
      "!**/.bundled",
      "!**/dist",
      "!**/target",
      "!**/.turbo",
      "!**/node_modules",
      "!apps/studio/src/assets/geo",
      "!packages/cli/test/fixtures/theme-*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@base-ui/react": "Import UI primitives through @cloudhal/ui, never Base UI directly.",
              "@radix-ui/themes": "Cloudhal admin UIs use Kumo via @cloudhal/ui.",
              "lucide-react": "Icons come from @phosphor-icons/react (Kumo's icon set).",
              "react-icons": "Icons come from @phosphor-icons/react (Kumo's icon set).",
              "@heroicons/react": "Icons come from @phosphor-icons/react (Kumo's icon set).",
              "temporal-polyfill": "RFC-0008 §9.4: import Temporal from temporal-polyfill/implementation only, never a native or global Temporal.",
              "temporal-polyfill/global": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
              "temporal-polyfill/shim": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
              "temporal-polyfill/full": "RFC-0008 §9.4: import temporal-polyfill/implementation only.",
              "temporal-polyfill/full/global": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
              "temporal-polyfill/full/shim": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation."
            }
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 800
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 150
          }
        },
        "useMaxParams": {
          "level": "warn",
          "options": {
            "max": 4
          }
        }
      },
      "suspicious": {
        "noUselessEscapeInString": {
          "level": "error",
          "fix": "none"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@base-ui/react": "Import UI primitives through @cloudhal/ui, never Base UI directly.",
                  "@radix-ui/themes": "Cloudhal admin UIs use Kumo via @cloudhal/ui.",
                  "@cloudflare/kumo": "Apps import Kumo through @cloudhal/ui (one entry point, our blocks included).",
                  "lucide-react": "Icons come from @phosphor-icons/react (Kumo's icon set).",
                  "react-icons": "Icons come from @phosphor-icons/react (Kumo's icon set).",
                  "@heroicons/react": "Icons come from @phosphor-icons/react (Kumo's icon set).",
                  "temporal-polyfill": "RFC-0008 §9.4: import Temporal from temporal-polyfill/implementation only, never a native or global Temporal.",
                  "temporal-polyfill/global": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
                  "temporal-polyfill/shim": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
                  "temporal-polyfill/full": "RFC-0008 §9.4: import temporal-polyfill/implementation only.",
                  "temporal-polyfill/full/global": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation.",
                  "temporal-polyfill/full/shim": "RFC-0008 §9.4: never install a global Temporal; import temporal-polyfill/implementation."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**",
        "**/tests/**",
        "**/src/testing*.ts",
        "**/fixtures.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off",
            "useMaxParams": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 1500
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/studio/src/i18n/en.ts",
        "apps/studio/src/i18n/tr.ts",
        "apps/studio/src/i18n/lazy/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/blocks/kumo/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
