{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "gen:ts": {
      "inputs": ["schemas/**", "scripts/**"],
      "outputs": ["src/generated/**", "schemas/.bundled/**"]
    },
    "gen:rs": {
      "inputs": ["schemas/**", "scripts/**"],
      "outputs": ["../../crates/cloudhal-schema/src/generated/**", "schemas/.bundled/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "gen:ts"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["gen:ts", "transit"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["typecheck", "test"],
      "outputs": []
    }
  }
}
